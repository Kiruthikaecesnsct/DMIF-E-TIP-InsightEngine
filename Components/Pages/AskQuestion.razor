@page "/ask"
@using InsightEngine.Models.DataSources
@using InsightEngine.Models.Agents
@using InsightEngine.Models.Queries
@using InsightEngine.Repositories
@using InsightEngine.Services
@using InsightEngine.Services.Orchestration
@using System.Text.Json
@inject IDataSourceRepository DataSourceRepo
@inject IQueryRepository QueryRepo
@inject AnalysisPipelineService Pipeline
@inject AnomalyDetectionService AnomalyDetector
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Ask a Question</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Ask a Business Question</MudText>

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="string"
                   Label="Select Data Source"
                   @bind-Value="_selectedDataSourceId"
                   Variant="Variant.Outlined"
                   FullWidth="true">
            @foreach (var ds in _dataSources)
            {
                <MudSelectItem Value="@ds.Id">@ds.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="_question"
                      Label="Ask your question in plain English"
                      Placeholder="e.g. What were the top 5 products by revenue last quarter?"
                      Variant="Variant.Outlined"
                      Lines="2"
                      FullWidth="true" />
    </MudItem>

    <MudItem xs="12">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="RunPipeline"
                   Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_question))"
                   Size="Size.Large">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="mr-2" />
                <span>Analyzing...</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                         Class="mr-2" />
                <span>Ask Question</span>
            }
        </MudButton>
    </MudItem>
</MudGrid>

@if (_isLoading)
{
    <MudCard Class="mt-4">
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="mb-2">@_currentStage</MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mt-4"
              ShowCloseIcon="true"
              CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@if (_result != null && _result.Success)
{
    <MudDivider Class="my-4" />

    <!-- Metadata chips -->
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3">
        <MudChip T="String" Color="Color.Info"
                 Icon="@Icons.Material.Filled.Timer">
            @(_result.ExecutionTimeMs)ms
        </MudChip>
        <MudChip T="String" Color="Color.Primary"
                 Icon="@Icons.Material.Filled.TableRows">
            @(_result.RowCount) rows
        </MudChip>
        @if (_result.ChartConfig != null)
        {
            <MudChip T="String" Color="Color.Secondary"
                     Icon="@Icons.Material.Filled.BarChart">
                @(_result.ChartConfig.ChartType.Replace("_", " "))
            </MudChip>
        }
        @if (_anomalies.Any())
        {
            <MudChip T="String" Color="Color.Warning"
                     Icon="@Icons.Material.Filled.Warning">
                @(_anomalies.Count) anomaly alert(s)
            </MudChip>
        }
    </MudStack>

    <!-- Statistics + Trends + Outliers + Anomalies Panel -->
    <StatisticsPanel Statistics="_result.Statistics"
                     Trends="_result.Trends"
                     Outliers="_result.Outliers"
                     Anomalies="_anomalies"
                     NumberFormat="@(_result.ChartConfig?.NumberFormat ?? "number")" />

    <!-- Chart -->
    @if (_result.ChartConfig != null &&
         _result.ChartConfig.ChartType != "table" &&
         _result.ChartConfig.ChartType != "stat_card" &&
         _result.Data.Any())
    {
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        @_result.ChartConfig.Title
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @_result.ChartConfig.Reasoning
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <ChartDisplay ChartConfig="_result.ChartConfig"
                              Data="_result.Data"
                              Height="350px"
                              ChartId="main" />
            </MudCardContent>
        </MudCard>
    }

    @if (_result.ChartConfig?.ChartType == "stat_card" && _result.Data.Any())
    {
        <ChartDisplay ChartConfig="_result.ChartConfig"
                      Data="_result.Data"
                      ChartId="statcard" />
    }

    <!-- Generated SQL -->
    <MudExpansionPanels Class="mb-4">
        <MudExpansionPanel Text="View Generated SQL">
            <MudText Typo="Typo.body2"
                     Style="font-family: monospace; white-space: pre-wrap;
                            background:#f5f5f5; padding:16px; border-radius:4px;
                            font-size:13px">
                @_result.GeneratedSQL
            </MudText>
        </MudExpansionPanel>

        @if (_result.Statistics.Any())
        {
            <MudExpansionPanel Text="View All Statistics">
                <MudSimpleTable Dense="true">
                    <tbody>
                        @foreach (var stat in _result.Statistics)
                        {
                            <tr>
                                <td><strong>@stat.Key</strong></td>
                                <td>@stat.Value</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>

    <!-- Results Table -->
    @if (_result.Data.Any())
    {
        <MudText Typo="Typo.h6" Class="mb-2">Data Results</MudText>
        <MudTable Items="@_result.Data"
                  Hover="true"
                  Striped="true"
                  Bordered="true"
                  Dense="true"
                  Elevation="1">
            <HeaderContent>
                @foreach (var col in _columns)
                {
                    <MudTh>@col</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                @foreach (var col in _columns)
                {
                    <MudTd>
                        @(context.ContainsKey(col)
                            ? FormatValue(context[col],
                                _result.ChartConfig?.NumberFormat)
                            : "")
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<DataSource> _dataSources = new();
    private string _selectedDataSourceId = string.Empty;
    private string _question = string.Empty;
    private bool _isLoading;
    private string _errorMessage = string.Empty;
    private string _currentStage = string.Empty;
    private PipelineResult? _result;
    private List<string> _columns = new();
    private List<AnomalyAlert> _anomalies = new();

    protected override async Task OnInitializedAsync()
    {
        _dataSources = await DataSourceRepo.GetAllActiveAsync();
        if (_dataSources.Any())
            _selectedDataSourceId = _dataSources.First().Id;
    }

    private async Task RunPipeline()
    {
        if (string.IsNullOrWhiteSpace(_question)) return;

        _isLoading = true;
        _errorMessage = string.Empty;
        _result = null;
        _columns = new();
        _anomalies = new();

        try
        {
            var dataSource = await DataSourceRepo
                .GetByIdAsync(_selectedDataSourceId);

            if (dataSource == null)
            {
                _errorMessage = "Please select a valid data source.";
                return;
            }

            _currentStage = "Stage 1/3: Interpreting your question...";
            StateHasChanged();
            await Task.Delay(50);

            _result = await Pipeline.ExecuteAsync(_question, dataSource);

            if (!_result.Success)
            {
                _errorMessage = _result.ErrorMessage
                    ?? "An error occurred. Please try again.";
                return;
            }

            _currentStage = "Stage 3/3: Preparing visualization...";
            StateHasChanged();

            if (_result.Data.Any())
                _columns = _result.Data.First().Keys.ToList();

            // Run anomaly detection
            try
            {
                _anomalies = AnomalyDetector.DetectAnomalies(_result.Data);
            }
            catch (Exception ex)
            {
                // Non-fatal — just log and continue
                Console.WriteLine($"Anomaly detection skipped: {ex.Message}");
            }

            // Save to MongoDB
            var queryRequest = new QueryRequest
            {
                NaturalLanguageQuery = _question,
                DataSourceId = _selectedDataSourceId,
                Status = QueryStatus.Completed
            };
            await QueryRepo.SaveQueryAsync(queryRequest);

            var queryResult = new QueryResult
            {
                QueryRequestId = queryRequest.Id,
                GeneratedSQL = _result.GeneratedSQL,
                Confidence = _result.Confidence,
                TablesUsed = new List<string>(),
                Explanation = _result.ChartConfig?.Reasoning ?? string.Empty,
                ExecutionTimeMs = _result.ExecutionTimeMs,
                RowCount = _result.RowCount,
                RawResults = JsonSerializer.Serialize(_result.Data)
            };
            await QueryRepo.SaveResultAsync(queryResult);

            Snackbar.Add("Analysis complete!", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            _currentStage = string.Empty;
        }
    }

    private string FormatValue(object? value, string? format)
    {
        if (value == null) return string.Empty;
        if (format == "currency" &&
            double.TryParse(value.ToString(), out var d))
            return d.ToString("C2");
        return value.ToString() ?? string.Empty;
    }
}